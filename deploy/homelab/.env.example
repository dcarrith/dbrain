# ============================================================================
# dbrain — Open-Source Decentralized Brain Environment Configuration
# ============================================================================

# --- 1. Core Node & Topology Settings ---
PORT=3000
NODE_ENV=production
DBRAIN_TOPOLOGY_PROFILE=homelab          # homelab | community | city
DBRAIN_NODE_NAME="Homelab Sovereign Brain"
DBRAIN_DATA_DIR=/var/lib/dbrain
DBRAIN_STATE_DIR=/tmp/dbrain-state
DBRAIN_VAULT_PATH=""                     # Optional path to Obsidian [[wikilink]] / gbrain Markdown vault
CANONICAL_HOST=localhost:3000
TRUST_PROXY=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- 2. Chia Layer-1, DataLayer & DIG Network Integration ---
CHIA_NETWORK=mainnet                     # mainnet | testnet11
CHIA_PREFIX=xch                          # xch (mainnet) | txch (testnet11)
CHIA_GENESIS_CHALLENGE=0xccd5bb71183532bff220ba46c268991a3ff07eb358e8255a65c30a2dce0e5fbb
CHIA_DATALAYER_HTTP_URL=http://localhost:8562
CHIA_DATALAYER_RPC_URL=https://localhost:8562
CHIA_CHAIMCP_URL=""                      # Optional ChaiMCP JSON-RPC bridge (e.g. http://chaimcp.default.svc.cluster.local:80/mcp)
CHIA_CHAIMCP_TOKEN=""
CHIA_DBRAIN_PRIMARY_STORE_ID=""          # Optional 32-byte hex Chia DataLayer Singleton Store ID (0x...)
DIG_CAPSULE_PRICE_BASE_UNITS=25000       # 0 in Tier-1 off-chain working tree; 25000 (25 $DIG) on Tier-2 L1 promotion

# --- 3. Custody, CHIP-0028/0043 Air-Gapped Clear Signing & Post-Quantum Security ---
DBRAIN_OPERATOR_DID=did:chia:1homelaboperator0000000000000000000000000000000000000000
DBRAIN_ADMIN_DIDS=""                     # Comma-separated allowlist of Chia DIDs for Ring-0 reflexes & admin ops
DBRAIN_ADMIN_KEY=""                      # Optional break-glass local CLI admin token
DBRAIN_CLEAR_SIGN_CURVE=Secp256r1_Passkey # Secp256r1_Passkey | Secp256k1_HardwareWallet | BLS12_381_ColdKey
DBRAIN_MIPS_QUORUM=1-of-1                # 1-of-1 (homelab) | 2-of-3 (community) | 3-of-5 (city)
DBRAIN_PQC_MODE=ML-DSA-65+Ed25519-Hybrid # Hybrid FIPS-204 (ML-DSA-65) + RFC-8032 (Ed25519) capsule signatures
DBRAIN_CORTEX_JWK_PATH=/var/lib/dbrain/cortex-keypair.jwk.json

# --- 4. Swarm Consensus, Split-Brain Defense & Rust Acceleration ---
DBRAIN_L1_CHECKPOINT_INTERVAL=24h        # 24h (homelab) | 6h (community) | 1h (city)
DBRAIN_ALIGNMENT_LEASE_TTL_SEC=15        # Alignment Lease heartbeat TTL before Split-Brain Partition Fence triggers
DBRAIN_CANARY_GATE_MIN_SCORE=0.95        # Minimum 5-stage Epistemic Canary Gate score required for branch merge
DBRAIN_RUST_ACCEL=auto                   # auto | native | wasm | js-fallback
